# --- Database ---
DATABASE_URL=postgresql+psycopg2://portfolio:changeme@localhost:5433/portfolio_builder_db

# --- JWT ---
JWT_SECRET_KEY=insecure-dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Mobile number lookup hashing ---
MOBILE_LOOKUP_KEY=insecure-dev-lookup-key-change-me

# --- OTP ---
# dev_fixed: always uses FIXED_DEV_OTP, printed to console by DevConsoleOTPProvider.
# provider: sends the OTP via WhatsApp (WhatsAppBusinessProvider, see below).
OTP_MODE=dev_fixed
FIXED_DEV_OTP=123456
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# --- WhatsApp Business API (Meta Graph API) — required when OTP_MODE=provider ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=otp_verification
WHATSAPP_TEMPLATE_LANG=en

# --- Default admin (bootstrapped by seed, no OTP required) ---
DEFAULT_ADMIN_MOBILE=+910000000000
DEFAULT_ADMIN_PASSWORD=changeme123

# --- CORS (add the QR Store Builder app origin) ---
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:3000

# --- QR Store Builder Pro plan (billing product "qr_store_pro"); 0 = not sold ---
QR_STORE_PRO_PRICE_RUPEES=0
# Split Bill only (product "qr_split_bill") and Pro + Split Bill bundle ("qr_pro_split"); 0 = not sold
QR_SPLIT_BILL_PRICE_RUPEES=0
QR_PRO_SPLIT_PRICE_RUPEES=0

# --- AI Assistant chat widget ---
AI_ASSISTANT_MAX_QA_PAIRS=20
AI_ASSISTANT_QUESTION_MAX_LENGTH=150
AI_ASSISTANT_ANSWER_MAX_LENGTH=500
AI_ASSISTANT_DAILY_MESSAGE_LIMIT=200
AI_ASSISTANT_ADD_ON_PRICE_RUPEES=499

# Exactly one LLM provider must be enabled: "anthropic" or "azure_openai".
# "anthropic" reuses ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL / ANTHROPIC_MODEL.
# --- MePage website assistant (public bot on mepage.in) ---
MEPAGE_ASSISTANT_ENABLED=true
MEPAGE_ASSISTANT_ALLOWED_ORIGINS=https://mepage.in,https://www.mepage.in
MEPAGE_ASSISTANT_MAX_MESSAGE_CHARS=500
MEPAGE_ASSISTANT_MAX_HISTORY_TURNS=6
MEPAGE_ASSISTANT_MAX_OUTPUT_TOKENS=400
MEPAGE_ASSISTANT_IP_LIMIT=15
MEPAGE_ASSISTANT_IP_WINDOW_SECONDS=600
MEPAGE_ASSISTANT_DAILY_LIMIT=2000
# true ONLY when the API is reached through nginx (so X-Forwarded-For is trustworthy)
MEPAGE_ASSISTANT_TRUST_PROXY=true

LLM_PROVIDER=anthropic
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
